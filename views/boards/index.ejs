<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DESIGNBREW BOARDS</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
    <div class="logo-Navbar">
        <img class="logoImage" src="https://i.postimg.cc/8Czg7gpx/Design-BRew-1.png" alt="logo">
        <div class="header">
        <%- include('../partials/_navbar.ejs') %>
        </div>
        </div>
         <h1 class="profileH1"> Welcome <%= user.name %>!</h1> 
         <div class="inpsoBoard">   
         <div class="allBoards">
            <ul>
             <% boards.forEach((board) => {%>
                    <li>
                        <div><img class="profilepicture" src="https://i.postimg.cc/NGXLYP0C/WELCOME-TO-DESIGNBREW-1.png" alt="temp profile pic" style="max-width: 700px;"></div>
                        <a href="/users/<%= user._id%>/boards/<%= board._id%>"><%= board.category%></a>
                   </li>
                    <% }) %>
             </ul>
         </div>
         </div>
</body>
</html>