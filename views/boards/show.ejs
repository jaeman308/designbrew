<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Board Details</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
    <div class="logo-Navbar">
        <img class="logoImage" src="https://i.postimg.cc/8Czg7gpx/Design-BRew-1.png" alt="logo">
        <div class="header">
            <%- include('../partials/_navbar.ejs') %>
        </div>
    </div>
    
    <h1>Room: <%= board.room %></h1>
    <h2>Category: <%= board.category %></h2>
    <h2>Description:</h2> <p<> <%= board.description %></p>
    <div class=" category">
    <% if (board.image) { %>
        <img src="<%= board.image %>" alt="Board Image" style="max-width: 200px;">
    <% } %>
    </div>
    
    <div class="buttons">
        <form action="/users/<%= user._id %>/boards/<%= board._id %>/edit" method="GET" style="display:inline">
            <button type="submit" class="editButton">Edit</button>
        </form>
        
        <form action="/users/<%= user._id %>/boards/<%= board._id %>?_method=DELETE" method="POST" style="display:inline">
            <button type="submit" class="deleteButton">Delete</button>
        </form>
        <form action="/users/<%= user._id %>/boards" style="display:inline">
            <button type="submit" class="backBoard">Back to Boards</button>
        </form>
          </div>
    
</body>
</html>
